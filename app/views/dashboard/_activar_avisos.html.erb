<%# Para quien aún no recibe avisos en ningún dispositivo: sin esto, los recordatorios y las convocatorias se quedan
    en la campana. El controlador la muestra solo si este navegador puede activarlos (o explica cómo en iPhone). %>
<% if current_user.push_subscriptions.none? %>
  <div class="card border-0 shadow-sm mb-3 d-none" data-controller="activar-avisos" id="activar-avisos">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
      <i class="bi bi-bell fs-3 text-primary"></i>
      <div class="flex-grow-1" style="min-width:14rem;">
        <div class="fw-semibold">Activa los avisos en este teléfono</div>
        <div class="text-muted small">Te llegan las convocatorias, el recordatorio del día antes y las votaciones, sin tener que entrar a mirar.</div>
        <div class="small mt-1 d-none" data-activar-avisos-target="estado"></div>
      </div>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-primary" data-activar-avisos-target="boton" data-action="activar-avisos#activar">Activar avisos</button>
        <button type="button" class="btn btn-sm btn-link text-muted" data-action="activar-avisos#ahoraNo">Ahora no</button>
      </div>
    </div>
  </div>
<% end %>
