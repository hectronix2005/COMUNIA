<% content_for(:title, "Inicio — #{@logia.nombre_display}") %>

<div>

  <%# ---- Page Header ---- %>
  <div class="page-header mb-4">
    <div>
      <h1 class="h3 fw-bold"><%= @logia.icono_display %> <%= @logia.nombre_display %></h1>
      <p class="text-muted mb-0"><%= @logia.ruta_comunidad %> <span class="badge bg-secondary ms-1"><%= @logia.codigo %></span></p>
    </div>
    <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i><%= l(Date.current, format: :long) %></div>
  </div>

  <%= render "dashboard/activar_avisos" unless current_user.invitado? %>
  <%= render "reuniones/proxima" %>
  <%= render "dashboard/mis_acuerdos" %>
  <%# Lo que le toca hoy a quien administra, antes que los módulos plegados. %>
  <% if @soporte_adjunto.positive? %>
    <%= link_to cobros_path(estado: "soporte_adjunto"), class: "acceso mb-4" do %>
      <span class="icono-chip chip-info"><i class="bi bi-paperclip"></i></span>
      <span class="flex-grow-1 min-w-0">
        <span class="acceso-titulo d-block"><%= @soporte_adjunto == 1 ? "1 pago espera que lo valides" : "#{@soporte_adjunto} pagos esperan que los valides" %></span>
        <span class="acceso-detalle">Enviaron el soporte; revísalo y confírmalo.</span>
      </span>
      <i class="bi bi-chevron-right text-muted"></i>
    <% end %>
  <% end %>
  <%= render "calendario/proximos" %>
  <%= render "adopcion" %>

  <%# Un módulo por área: cabecera blanca con su icono; dentro, accesos y cifras. El color de estado va solo en el icono. %>
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <%= link_to miembros_path, class: "acceso" do %>
        <span class="icono-chip"><i class="bi bi-people"></i></span>
        <span>
          <span class="acceso-cifra d-block"><%= @miembros_activos %></span>
          <span class="acceso-detalle"><%= Logia.plural(@logia.t_miembro).downcase %> activos</span>
        </span>
      <% end %>
    </div>
  </div>

  <%# ---- Tesorería ---- %>
  <section class="modulo">
    <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#tesoreriaBody"
            aria-expanded="false" aria-controls="tesoreriaBody">
      <span class="icono-chip"><i class="bi bi-bank2"></i></span>
      <span>
        <span class="modulo-titulo d-block">Tesorería</span>
        <span class="modulo-detalle">Cobranza · Recaudación · Reportes</span>
      </span>
      <i class="bi bi-chevron-down"></i>
    </button>

    <div class="collapse" id="tesoreriaBody">
      <div class="modulo-cuerpo">
        <h2 class="seccion-titulo">Estado de <%= Logia.plural(@logia.t_cobro).downcase %></h2>
        <div class="row g-3 mb-4">
          <% [["pendiente", "bi-clock-history", "chip-aviso", @pendientes, "Pendientes"],
              ["soporte_adjunto", "bi-paperclip", "chip-info", @soporte_adjunto, "Por validar"],
              ["pagado", "bi-check-circle", "chip-exito", @pagados, "Pagados"],
              ["vencido", "bi-exclamation-circle", "chip-peligro", @vencidos, "Vencidos"]].each do |estado, icono, chip, cifra, texto| %>
            <div class="col-6 col-xl-3">
              <%= link_to cobros_path(estado: estado), class: "acceso" do %>
                <span class="icono-chip <%= chip %>"><i class="bi <%= icono %>"></i></span>
                <span>
                  <span class="acceso-cifra d-block"><%= cifra %></span>
                  <span class="acceso-detalle"><%= texto %></span>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <h2 class="seccion-titulo">Resumen financiero</h2>
        <div class="row g-3 mb-4">
          <% [[recaudacion_reportes_path(fecha_desde: Date.current.beginning_of_month, fecha_hasta: Date.current.end_of_month),
               "bi-calendar-month", "", @monto_mes, "Recaudado este mes"],
              [recaudacion_reportes_path(fecha_desde: Date.current.beginning_of_year, fecha_hasta: Date.current.end_of_year),
               "bi-graph-up", "", @monto_anio, "Recaudado este año"],
              [cartera_reportes_path, "bi-wallet2", "chip-aviso", @monto_cartera, "Cartera pendiente"],
              [morosos_reportes_path, "bi-exclamation-triangle", "chip-peligro", @monto_mora, "En mora"]].each do |ruta, icono, chip, monto, texto| %>
            <div class="col-6 col-xl-3">
              <%= link_to ruta, class: "acceso" do %>
                <span class="icono-chip <%= chip %>"><i class="bi <%= icono %>"></i></span>
                <span class="min-w-0">
                  <span class="acceso-titulo d-block text-truncate"><%= pesos(monto) %></span>
                  <span class="acceso-detalle"><%= texto %></span>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <h2 class="seccion-titulo">Ir a</h2>
        <div class="d-flex flex-wrap gap-2 mb-4">
          <%= link_to cobros_path, class: "btn btn-light border" do %><i class="bi bi-receipt me-1"></i><%= Logia.plural(@logia.t_cobro) %><% end %>
          <%= link_to cobros_path(estado: "soporte_adjunto"), class: "btn btn-light border" do %>
            <i class="bi bi-paperclip me-1"></i>Por validar
            <% if @soporte_adjunto > 0 %><span class="badge rounded-pill bg-danger ms-1"><%= @soporte_adjunto %></span><% end %>
          <% end %>
          <%= link_to periodo_cobros_path, class: "btn btn-light border" do %><i class="bi bi-calendar-check me-1"></i>Periodos<% end %>
          <% if current_user.tiene_permiso?("logias", "gestionar_conceptos") && current_user.logia.present? %>
            <%= link_to logia_conceptos_cobro_path(current_user.logia), class: "btn btn-light border" do %><i class="bi bi-list-columns-reverse me-1"></i>Cuota mensual<% end %>
          <% end %>
          <% if current_user.tiene_permiso?("reportes", "recaudacion") %>
            <%= link_to recaudacion_reportes_path, class: "btn btn-light border" do %><i class="bi bi-cash-stack me-1"></i>Recaudación<% end %>
          <% end %>
          <% if current_user.tiene_permiso?("reportes", "cartera") %>
            <%= link_to cartera_reportes_path, class: "btn btn-light border" do %><i class="bi bi-wallet2 me-1"></i>Cartera<% end %>
          <% end %>
          <% if current_user.tiene_permiso?("reportes", "morosos") %>
            <%= link_to morosos_reportes_path, class: "btn btn-light border" do %><i class="bi bi-exclamation-triangle me-1"></i>Morosos<% end %>
          <% end %>
        </div>

        <h2 class="seccion-titulo">Cobros por validar <span class="badge bg-light text-dark border ms-1"><%= @cobros_por_validar.size %></span></h2>
        <% if @cobros_por_validar.any? %>
          <div class="table-responsive rounded border">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Miembro</th>
                  <th>Periodo</th>
                  <th class="text-end">Monto</th>
                  <th>Actualizado</th>
                  <th class="text-end"><span class="visually-hidden">Acción</span></th>
                </tr>
              </thead>
              <tbody>
                <% @cobros_por_validar.each do |cobro| %>
                  <tr>
                    <td class="fw-semibold"><%= cobro.miembro.nombre_completo %></td>
                    <td><%= cobro.periodo_cobro.nombre %></td>
                    <td class="text-end fw-semibold"><%= pesos(cobro.monto) %></td>
                    <td class="small text-muted">hace <%= time_ago_in_words(cobro.updated_at) %></td>
                    <td class="text-end">
                      <%= link_to validar_cobro_path(cobro), class: "btn btn-sm btn-primary" do %><i class="bi bi-check2-square me-1"></i>Validar<% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="text-end mt-2">
            <%= link_to cobros_path(estado: "soporte_adjunto"), class: "small fw-semibold text-decoration-none" do %>Ver todos <i class="bi bi-arrow-right"></i><% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0"><i class="bi bi-check-circle text-success me-1"></i>Todo al día: no hay cobros por validar.</p>
        <% end %>
      </div>
    </div>
  </section>

  <%# ---- Comunidad ---- %>
  <section class="modulo">
    <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#comunidadBody"
            aria-expanded="true" aria-controls="comunidadBody">
      <span class="icono-chip"><i class="bi bi-people"></i></span>
      <span>
        <span class="modulo-titulo d-block">Comunidad</span>
        <span class="modulo-detalle">Muro · Chat · Encuestas · Directorio · Calendario</span>
      </span>
      <i class="bi bi-chevron-down"></i>
    </button>

    <div class="collapse show" id="comunidadBody">
      <div class="modulo-cuerpo">
        <div class="row g-3 mb-4">
          <% [[publicaciones_path, "bi-newspaper", "Muro", "Publicaciones y noticias"],
              [chat_path, "bi-chat-dots", "Chat", "Mensajes y canales"],
              [encuestas_path, "bi-bar-chart", "Encuestas", "Votaciones y opiniones"],
              [directorio_index_path, "bi-person-vcard", "Directorio", "Perfiles de miembros"],
              [calendario_index_path, "bi-calendar3", "Calendario", "Eventos y asistencia"],
              [hospitalia_cumpleanos_path, "bi-balloon-heart", "Cumpleaños", "#{@hospitalia_cumpleanos || 0} próximos"]].each do |ruta, icono, titulo, detalle| %>
            <div class="col-6 col-xl-4">
              <%= link_to ruta, class: "acceso" do %>
                <span class="icono-chip"><i class="bi <%= icono %>"></i></span>
                <span class="min-w-0">
                  <span class="acceso-titulo d-block"><%= titulo %></span>
                  <span class="acceso-detalle d-none d-sm-inline"><%= detalle %></span>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <% ultimos = ChatMensaje.where(logia: current_logia).includes(:user).order(created_at: :desc).limit(3).reverse %>
        <% if ultimos.any? %>
          <h2 class="seccion-titulo">Últimos mensajes</h2>
          <ul class="list-unstyled border rounded-3 p-3 mb-0">
            <% ultimos.each do |m| %>
              <li class="d-flex gap-2 mb-2">
                <span class="icono-chip chip-sm fw-bold"><%= m.user.nombre[0].upcase %><%= m.user.apellido[0].upcase %></span>
                <div class="min-w-0">
                  <span class="fw-semibold small"><%= m.user.nombre_completo %></span>
                  <span class="small text-muted ms-1"><%= m.created_at.strftime("%d/%m %H:%M") %></span>
                  <div class="small text-truncate"><%= truncate(m.contenido, length: 80) %></div>
                </div>
              </li>
            <% end %>
            <li class="text-end"><%= link_to chat_path, class: "small fw-semibold text-decoration-none" do %>Ver el chat <i class="bi bi-arrow-right"></i><% end %></li>
          </ul>
        <% end %>
      </div>
    </div>
  </section>

  <% if current_logia.modulo?(:documentos) || current_logia.modulo?(:biblioteca) %>
    <%# ---- Biblioteca ---- %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#bibliotecaBody"
              aria-expanded="false" aria-controls="bibliotecaBody">
        <span class="icono-chip"><i class="bi bi-book-half"></i></span>
        <span>
          <span class="modulo-titulo d-block">Biblioteca</span>
          <span class="modulo-detalle"><%= [(current_logia.t_documentos if current_logia.modulo?(:documentos)), ("Libros" if current_logia.modulo?(:biblioteca))].compact.join(" · ") %></span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="bibliotecaBody">
        <div class="modulo-cuerpo">
          <div class="row g-3 mb-3">
            <% if current_logia.modulo?(:documentos) %>
              <div class="col-6 col-xl-3">
                <%= link_to biblioteca_planchas_path, class: "acceso" do %>
                  <span class="icono-chip"><i class="bi bi-file-earmark-text"></i></span>
                  <span>
                    <span class="acceso-cifra d-block"><%= @biblioteca_planchas_count || 0 %></span>
                    <span class="acceso-detalle"><%= current_logia.t_documentos %></span>
                  </span>
                <% end %>
              </div>
            <% end %>
            <% if current_logia.modulo?(:biblioteca) %>
              <div class="col-6 col-xl-3">
                <%= link_to biblioteca_libros_path, class: "acceso" do %>
                  <span class="icono-chip"><i class="bi bi-book"></i></span>
                  <span>
                    <span class="acceso-cifra d-block"><%= @biblioteca_libros_count || 0 %></span>
                    <span class="acceso-detalle">Libros</span>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <% if current_logia.modulo?(:documentos) %>
              <%= link_to new_biblioteca_plancha_path, class: "btn btn-light border" do %><i class="bi bi-plus-lg me-1"></i>Subir documento<% end %>
            <% end %>
            <% if current_logia.modulo?(:biblioteca) %>
              <%= link_to new_biblioteca_libro_path, class: "btn btn-light border" do %><i class="bi bi-plus-lg me-1"></i>Agregar libro<% end %>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_logia.modulo?(:ayuda) %>
    <%# ---- Fondo de ayuda (Hospitalia, con el nombre de la categoría) ---- %>
    <% h_recaudado = HospitaliaRecaudo.de_logia(current_logia.id).sum(:monto) %>
    <% h_gastado   = HospitaliaGasto.de_logia(current_logia.id).sum(:monto) %>
    <% saldo = h_recaudado - h_gastado %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#hospitaliaBody"
              aria-expanded="false" aria-controls="hospitaliaBody">
        <span class="icono-chip"><i class="bi bi-heart-pulse"></i></span>
        <span>
          <span class="modulo-titulo d-block"><%= current_logia.t_ayuda %></span>
          <span class="modulo-detalle">Fondo de apoyo mutuo · Cumpleaños · Familiares</span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="hospitaliaBody">
        <div class="modulo-cuerpo">
          <div class="row g-3">
            <% [[hospitalia_recaudos_path, "bi-arrow-down-circle", "chip-exito", h_recaudado, "Recaudos"],
                [hospitalia_gastos_path, "bi-arrow-up-circle", "", h_gastado, "Gastos"],
                [hospitalia_path, "bi-wallet2", (saldo.negative? ? "chip-peligro" : ""), saldo, "Saldo"]].each do |ruta, icono, chip, monto, texto| %>
              <div class="col-6 col-xl-3">
                <%= link_to ruta, class: "acceso" do %>
                  <span class="icono-chip <%= chip %>"><i class="bi <%= icono %>"></i></span>
                  <span class="min-w-0">
                    <span class="acceso-titulo d-block text-truncate"><%= number_to_currency(monto, unit: "$", delimiter: ".", separator: ",") %></span>
                    <span class="acceso-detalle"><%= texto %></span>
                  </span>
                <% end %>
              </div>
            <% end %>
            <div class="col-6 col-xl-3">
              <%= link_to hospitalia_cumpleanos_path, class: "acceso" do %>
                <span class="icono-chip"><i class="bi bi-balloon-heart"></i></span>
                <span>
                  <span class="acceso-cifra d-block"><%= @hospitalia_cumpleanos || 0 %></span>
                  <span class="acceso-detalle">Cumpleaños</span>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_logia.modulo?(:negocios) %>
    <%# ---- Negocios ---- %>
    <% ids_tenant = [current_logia.id] + (current_logia.tenant_id.nil? ? current_logia.logias.pluck(:id) : []) %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#negociosBody"
              aria-expanded="false" aria-controls="negociosBody">
        <span class="icono-chip"><i class="bi bi-briefcase"></i></span>
        <span>
          <span class="modulo-titulo d-block">Negocios</span>
          <span class="modulo-detalle">Servicios · Productos · Empleos de la comunidad</span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="negociosBody">
        <div class="modulo-cuerpo">
          <div class="row g-3 mb-3">
            <% NegocioAnuncio::TIPOS.each do |tipo| %>
              <div class="col-4">
                <%= link_to negocios_path(tipo: tipo), class: "acceso" do %>
                  <span>
                    <span class="acceso-cifra d-block"><%= NegocioAnuncio.where(logia_id: ids_tenant).activos.de_tipo(tipo).count %></span>
                    <span class="acceso-detalle"><%= NegocioAnuncio::TIPO_LABEL[tipo] %>s</span>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to negocios_path, class: "btn btn-light border" do %><i class="bi bi-grid me-1"></i>Ver negocios<% end %>
            <% NegocioAnuncio::TIPOS.each do |tipo| %>
              <%= link_to new_negocio_path(tipo: tipo), class: "btn btn-light border" do %><i class="bi bi-plus-lg me-1"></i><%= NegocioAnuncio::TIPO_LABEL[tipo] %><% end %>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

</div>
