<% content_for(:title, "Inicio") %>

<div>
  <%# ---- Page Header ---- %>
  <div class="page-header">
    <div>
      <h1 class="h3 fw-bold"><i class="bi bi-grid-3x3-gap me-2"></i>COMUNIA — Vista global</h1>
      <p class="text-muted mb-0">Resumen de todas las comunidades</p>
    </div>
    <div class="text-muted">
      <i class="bi bi-calendar3 me-1"></i>
      <%= l(Date.current, format: :long) %>
    </div>
  </div>

  <%# ---- Cifras: el color de estado va solo en el icono ---- %>
  <div class="row g-3 mb-4">
    <% [[miembros_path, "bi-people-fill", "", @total_miembros, "Miembros"],
        [cobros_path(estado: "pendiente"), "bi-clock-history", "chip-aviso", @total_cobros_pendientes, "Cobros pendientes"],
        [cobros_path(estado: "soporte_adjunto"), "bi-paperclip", "chip-info", @total_soporte_adjunto, "Soportes por validar"],
        [cobros_path(estado: "pagado"), "bi-check-circle-fill", "chip-exito", @total_pagados, "Pagos realizados"],
        [cobros_path(estado: "vencido"), "bi-exclamation-triangle-fill", "chip-peligro", @total_vencidos, "Vencidos"]].each do |ruta, icono, chip, cifra, texto| %>
      <div class="col-6 col-md-4 col-xl">
        <%= link_to ruta, class: "acceso" do %>
          <span class="icono-chip <%= chip %>"><i class="bi <%= icono %>"></i></span>
          <span>
            <span class="acceso-cifra d-block"><%= cifra %></span>
            <span class="acceso-detalle"><%= texto %></span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ---- Resumen por Logia ---- %>
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="card-title mb-0 text-white"><i class="bi bi-building me-2"></i>Resumen por comunidad</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-rounded">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Comunidad</th>
                <th>Código</th>
                <th class="text-end">Pendientes</th>
                <th class="text-end">Soporte enviado</th>
                <th class="text-end">Pagados</th>
                <th class="text-end">Vencidos</th>
                <th class="min-w-distribucion">Distribución</th>
              </tr>
            </thead>
            <tbody>
              <% @resumen_por_logia.each do |resumen| %>
                <% total = resumen[:pendientes] + resumen[:soporte_adjunto] + resumen[:pagados] + resumen[:vencidos] %>
                <tr>
                  <td>
                    <%= link_to logia_path(resumen[:logia]), class: "text-decoration-none fw-semibold" do %>
                      <i class="bi bi-building me-1 text-muted"></i><%= resumen[:logia].nombre %>
                    <% end %>
                  </td>
                  <td><span class="badge bg-secondary"><%= resumen[:logia].codigo %></span></td>
                  <td class="text-end"><span class="badge badge-pendiente"><%= resumen[:pendientes] %></span></td>
                  <td class="text-end"><span class="badge badge-soporte"><%= resumen[:soporte_adjunto] %></span></td>
                  <td class="text-end"><span class="badge badge-pagado"><%= resumen[:pagados] %></span></td>
                  <td class="text-end"><span class="badge badge-vencido"><%= resumen[:vencidos] %></span></td>
                  <td>
                    <% if total > 0 %>
                      <div class="progress progress-fina" title="Pagados: <%= resumen[:pagados] %> | Pendientes: <%= resumen[:pendientes] %> | Soporte: <%= resumen[:soporte_adjunto] %> | Vencidos: <%= resumen[:vencidos] %>">
                        <div class="progress-bar bg-success" style="width: <%= (resumen[:pagados].to_f / total * 100).round(1) %>%"></div>
                        <div class="progress-bar bg-warning" style="width: <%= (resumen[:pendientes].to_f / total * 100).round(1) %>%"></div>
                        <div class="progress-bar bg-info" style="width: <%= (resumen[:soporte_adjunto].to_f / total * 100).round(1) %>%"></div>
                        <div class="progress-bar bg-danger" style="width: <%= (resumen[:vencidos].to_f / total * 100).round(1) %>%"></div>
                      </div>
                    <% else %>
                      <span class="text-muted small">Sin cobros</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# ---- Cobros Pendientes de validación ---- %>
  <div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <h5 class="card-title mb-0">
        <i class="bi bi-hourglass-split me-2"></i>Pendientes de validación
      </h5>
      <span class="badge bg-info"><%= @cobros_recientes.size %></span>
    </div>
    <div class="card-body p-0">
      <% if @cobros_recientes.any? %>
        <div class="table-rounded">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Miembro</th>
                  <th>Comunidad</th>
                  <th>Periodo</th>
                  <th class="text-end">Monto</th>
                  <th>Actualizado</th>
                  <th class="text-center">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% @cobros_recientes.each do |cobro| %>
                  <tr>
                    <td class="fw-semibold"><%= cobro.miembro.nombre_completo %></td>
                    <td><%= cobro.miembro.logia.nombre %></td>
                    <td><%= cobro.periodo_cobro.nombre %></td>
                    <td class="text-end fw-semibold"><%= pesos(cobro.monto) %></td>
                    <td>
                      <small class="text-muted" title="<%= l(cobro.updated_at, format: :long) %>">
                        <i class="bi bi-clock me-1"></i>hace <%= time_ago_in_words(cobro.updated_at) %>
                      </small>
                    </td>
                    <td class="text-center">
                      <%= link_to validar_cobro_path(cobro), class: "btn btn-sm btn-primary" do %>
                        <i class="bi bi-check2-square me-1"></i>Validar
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="bi bi-check-circle"></i>
          </div>
          <p class="empty-state-title">Todo al día</p>
          <p class="empty-state-text">No hay cobros pendientes de validación.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
