<% content_for(:title, "Inicio") %>

<div>
  <div class="page-header">
    <div>
      <h1 class="h3 fw-bold">Hola, <%= current_user.nombre %></h1>
      <p class="text-muted mb-0"><%= (current_miembro&.logia || current_logia).ruta_comunidad %></p>
    </div>
    <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i><%= l(Date.current, format: :long) %></div>
  </div>

  <%= render "dashboard/activar_avisos" unless current_user.invitado? %>
  <%= render "reuniones/proxima" %>
  <%= render "dashboard/mis_acuerdos" %>
  <%= render "calendario/proximos" %>

  <% if @vencidos.any? %>
    <div class="alert alert-danger d-flex align-items-center mb-4">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      Tienes <%= pluralize(@vencidos.count, "cobro vencido", plural: "cobros vencidos") %>. Ponte al día desde «Mis cobros», más abajo.
    </div>
  <% end %>

  <%# Mis cobros en cifras: el color de estado va solo en el icono. %>
  <div class="row g-3 mb-4">
    <% [["bi-clock-history", "chip-aviso", @pendientes.count, "Pendientes"],
        ["bi-paperclip", "chip-info", @soporte_adjunto.count, "Soporte enviado"],
        ["bi-check-circle", "chip-exito", @pagados.count, "Pagados"],
        ["bi-exclamation-circle", "chip-peligro", @vencidos.count, "Vencidos"]].each do |icono, chip, cifra, texto| %>
      <div class="col-6 col-xl-3">
        <a href="#mis-cobros" class="acceso">
          <span class="icono-chip <%= chip %>"><i class="bi <%= icono %>"></i></span>
          <span>
            <span class="acceso-cifra d-block"><%= cifra %></span>
            <span class="acceso-detalle"><%= texto %></span>
          </span>
        </a>
      </div>
    <% end %>
  </div>

  <section class="modulo">
    <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#miembroComunidadBody"
            aria-expanded="true" aria-controls="miembroComunidadBody">
      <span class="icono-chip"><i class="bi bi-people"></i></span>
      <span>
        <span class="modulo-titulo d-block">Comunidad</span>
        <span class="modulo-detalle">Muro · Chat · Encuestas · Directorio · Calendario<%= " · #{current_logia.t_reuniones}" if current_logia.modulo?(:reuniones) %></span>
      </span>
      <i class="bi bi-chevron-down"></i>
    </button>
    <div class="collapse show" id="miembroComunidadBody">
      <div class="modulo-cuerpo">
        <div class="row g-2">
          <% accesos = [[publicaciones_path, "bi-newspaper", "Muro"], [chat_path, "bi-chat-dots", "Chat"],
                        [encuestas_path, "bi-bar-chart", "Encuestas"], [directorio_index_path, "bi-person-vcard", "Directorio"],
                        [calendario_index_path, "bi-calendar3", "Calendario"]]
             accesos << [reuniones_path, "bi-people", current_logia.t_reuniones] if current_logia.modulo?(:reuniones)
             accesos << [hospitalia_cumpleanos_path, "bi-balloon-heart", "Cumpleaños"] %>
          <% accesos.each do |ruta, icono, titulo| %>
            <div class="col-6 col-md-4">
              <%= link_to ruta, class: "acceso py-2" do %>
                <span class="icono-chip"><i class="bi <%= icono %>"></i></span><span class="acceso-titulo"><%= titulo %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <% if current_logia.modulo?(:documentos) || current_logia.modulo?(:biblioteca) %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#miembroBibliotecaBody"
              aria-expanded="false" aria-controls="miembroBibliotecaBody">
        <span class="icono-chip"><i class="bi bi-book-half"></i></span>
        <span>
          <span class="modulo-titulo d-block">Biblioteca</span>
          <span class="modulo-detalle"><%= [(current_logia.t_documentos + " (#{@biblioteca_planchas_count || 0})" if current_logia.modulo?(:documentos)), ("Libros (#{@biblioteca_libros_count || 0})" if current_logia.modulo?(:biblioteca))].compact.join(" · ") %></span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="miembroBibliotecaBody">
        <div class="modulo-cuerpo d-flex gap-2 flex-wrap">
          <% if current_logia.modulo?(:documentos) %>
            <%= link_to biblioteca_planchas_path, class: "btn btn-light border" do %><i class="bi bi-file-earmark-text me-1"></i><%= current_logia.t_documentos %><% end %>
          <% end %>
          <% if current_logia.modulo?(:biblioteca) %>
            <%= link_to biblioteca_libros_path, class: "btn btn-light border" do %><i class="bi bi-book me-1"></i>Libros<% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_logia.modulo?(:ayuda) %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#miembroHospitaliaBody"
              aria-expanded="false" aria-controls="miembroHospitaliaBody">
        <span class="icono-chip"><i class="bi bi-heart-pulse"></i></span>
        <span>
          <span class="modulo-titulo d-block"><%= current_logia.t_ayuda %></span>
          <span class="modulo-detalle">Fondo de apoyo mutuo · Cumpleaños</span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="miembroHospitaliaBody">
        <div class="modulo-cuerpo d-flex gap-2 flex-wrap">
          <% if current_user.tiene_cargo?("Hospitalario") %>
            <%= link_to hospitalia_path, class: "btn btn-light border" do %><i class="bi bi-wallet2 me-1"></i>Resumen<% end %>
          <% end %>
          <%= link_to hospitalia_cumpleanos_path, class: "btn btn-light border" do %><i class="bi bi-balloon-heart me-1"></i>Cumpleaños<% end %>
          <% if current_user.miembro %>
            <%= link_to hospitalia_familiares_path(miembro_id: current_user.miembro.id), class: "btn btn-light border" do %><i class="bi bi-people me-1"></i>Mi familia<% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_logia.modulo?(:negocios) %>
    <section class="modulo">
      <button class="modulo-cabecera" type="button" data-bs-toggle="collapse" data-bs-target="#miembroNegociosBody"
              aria-expanded="false" aria-controls="miembroNegociosBody">
        <span class="icono-chip"><i class="bi bi-briefcase"></i></span>
        <span>
          <span class="modulo-titulo d-block">Negocios</span>
          <span class="modulo-detalle"><%= pluralize(@negocios_count || 0, "anuncio activo", plural: "anuncios activos") %> en la comunidad</span>
        </span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="collapse" id="miembroNegociosBody">
        <div class="modulo-cuerpo d-flex gap-2 flex-wrap">
          <%= link_to negocios_path, class: "btn btn-light border" do %><i class="bi bi-grid me-1"></i>Ver negocios<% end %>
          <%= link_to new_negocio_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg me-1"></i>Publicar anuncio<% end %>
        </div>
      </div>
    </section>
  <% end %>

<%# ---- Tabla de Cobros ---- %>
  <% cobros_seleccionables = @cobros.select(&:puede_adjuntar_soporte?) %>

  <div class="card" id="mis-cobros">
    <div class="card-header">
      <h5 class="card-title mb-0"><i class="bi bi-receipt me-2"></i>Mis cobros</h5>
    </div>
    <div class="card-body p-0">
      <% if @cobros.any? %>
        <%= form_tag adjuntar_soporte_multiple_cobros_path, method: :get, id: "bulk-soporte-form" do %>
          <div class="table-rounded">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>Periodo</th>
                    <th class="text-end">Monto</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">RC</th>
                    <th class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% @cobros.each do |cobro| %>
                    <tr id="row-cobro-<%= cobro.id %>" class="<%= 'table-row-selected' if false %>">
                      <td class="fw-semibold"><%= cobro.periodo_cobro.nombre %></td>
                      <td class="text-end fw-semibold"><%= pesos(cobro.monto) %></td>
                      <td class="text-center"><%= render "shared/estado_badge", estado: cobro.estado %></td>
                      <td class="text-center"><%= cobro.pago&.numero_rc || "-" %></td>
                      <td class="text-center">
                        <% if cobro.puede_adjuntar_soporte? %>
                          <div class="d-flex align-items-center justify-content-center gap-2">
                            <input type="checkbox" name="cobro_ids[]" value="<%= cobro.id %>"
                                   class="form-check-input cobro-checkbox m-0"
                                   data-monto="<%= cobro.monto.to_i %>"
                                   data-row="row-cobro-<%= cobro.id %>"
                                   id="chk-<%= cobro.id %>">
                            <label for="chk-<%= cobro.id %>" class="btn btn-sm btn-outline-success mb-0 cobro-label">
                              <i class="bi bi-check2-square me-1"></i>Pagar
                            </label>
                          </div>
                        <% elsif cobro.soporte_adjunto? %>
                          <span class="badge bg-info-subtle text-info">
                            <i class="bi bi-hourglass-split me-1"></i>En validacion
                          </span>
                        <% elsif cobro.pagado? && cobro.pago.present? %>
                          <%= link_to recibo_reportes_path(pago_id: cobro.pago.id), class: "btn btn-sm btn-outline-success" do %>
                            <i class="bi bi-file-earmark-text me-1"></i>Ver Recibo
                          <% end %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
          </div>
          <p class="empty-state-title">No tienes cobros registrados</p>
          <p class="empty-state-text">Cuando se generen cobros para tu periodo, aparecerán aquí.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# ---- Barra fija inferior de pago ---- %>
<% if cobros_seleccionables.any? %>
<div id="pay-bar" class="pay-bar" style="display: none;">
  <div class="container-fluid d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
      <div class="pay-bar-icon">
        <i class="bi bi-cart-check"></i>
      </div>
      <div>
        <span class="text-white-50 small">Seleccionados:</span>
        <strong class="text-white ms-1"><span id="selected-count">0</span> mes(es)</strong>
      </div>
      <div class="vr bg-white-50 opacity-25 mx-2 d-none d-sm-block"></div>
      <div>
        <span class="text-white-50 small">Total a pagar:</span>
        <strong class="text-white fs-5 ms-1" id="selected-total">$0</strong>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" id="btn-clear-selection" class="btn btn-outline-light btn-sm">
        <i class="bi bi-x-lg me-1"></i>Limpiar
      </button>
      <button type="submit" form="bulk-soporte-form" class="btn btn-light btn-sm fw-semibold px-4">
        <i class="bi bi-cloud-upload me-1"></i>Adjuntar Comprobante por <span id="bar-total-btn">$0</span>
      </button>
    </div>
  </div>
</div>
<% end %>

<style>
  .pay-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(135deg, #1a2744 0%, #1e3a5f 100%);
    padding: 0.75rem 1rem;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.25);
    z-index: 1050;
    animation: slideUp 0.3s ease;
  }
  @keyframes slideUp {
    from { transform: translateY(100%); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  .pay-bar-icon {
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c5a24d;
    font-size: 1.1rem;
  }
  tr.table-row-selected {
    background-color: #e8f5e9 !important;
  }
  tr.table-row-selected td {
    background-color: #e8f5e9 !important;
  }
  .cobro-checkbox, .cobro-label { cursor: pointer; }
  .cobro-checkbox:checked + .cobro-label {
    background-color: #198754;
    border-color: #198754;
    color: #fff;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var checkboxes = document.querySelectorAll(".cobro-checkbox");
    var payBar = document.getElementById("pay-bar");
    var selectedCount = document.getElementById("selected-count");
    var selectedTotal = document.getElementById("selected-total");
    var barTotalBtn = document.getElementById("bar-total-btn");
    var btnClear = document.getElementById("btn-clear-selection");

    if (checkboxes.length === 0) return;

    function formatPesos(n) {
      return "$" + n.toLocaleString("es-CO");
    }

    function updatePayBar() {
      var checked = document.querySelectorAll(".cobro-checkbox:checked");
      var count = checked.length;
      var total = 0;
      checked.forEach(function(cb) { total += parseInt(cb.dataset.monto, 10); });

      // Highlight rows
      checkboxes.forEach(function(cb) {
        var row = document.getElementById(cb.dataset.row);
        if (row) {
          if (cb.checked) {
            row.classList.add("table-row-selected");
          } else {
            row.classList.remove("table-row-selected");
          }
        }
      });

      if (count > 0) {
        payBar.style.display = "block";
        selectedCount.textContent = count;
        selectedTotal.textContent = formatPesos(total);
        barTotalBtn.textContent = formatPesos(total);
      } else {
        payBar.style.display = "none";
      }
    }

    // Toggle via checkbox or label click
    checkboxes.forEach(function(cb) {
      cb.addEventListener("change", updatePayBar);
    });

    // Clear selection button
    if (btnClear) {
      btnClear.addEventListener("click", function() {
        checkboxes.forEach(function(cb) { cb.checked = false; });
        updatePayBar();
      });
    }
  });
</script>
