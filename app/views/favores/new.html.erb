<% pido = @favor.pido? %>
<% content_for(:title, pido ? "Pedir una mano" : "Ofrecer algo") %>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="mb-3">
      <%= link_to favores_path, class: "btn btn-sm btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Pido / ofrezco
      <% end %>
    </div>

    <div class="card">
      <div class="card-body">
        <h5 class="fw-bold mb-1"><%= pido ? "Pedir una mano" : "Ofrecer algo" %></h5>
        <p class="text-muted small mb-3">
          <% if pido %>
            Les llega un aviso a tus vecinos. Quien pueda te escribe por el chat.
          <% else %>
            Sale en «Pido / ofrezco» y en el resumen del lunes. Quien le interese te escribe por el chat.
          <% end %>
        </p>

        <%= form_with model: @favor, url: favores_path, local: true do |f| %>
          <% if @favor.errors.any? %>
            <div class="alert alert-danger"><%= @favor.errors.full_messages.join(". ") %></div>
          <% end %>

          <div class="btn-group w-100 mb-3" role="group" aria-label="Tipo">
            <%= f.radio_button :tipo, "pido", class: "btn-check", id: "favor_tipo_pido" %>
            <label class="btn btn-outline-primary" for="favor_tipo_pido">Pido</label>
            <%= f.radio_button :tipo, "ofrezco", class: "btn-check", id: "favor_tipo_ofrezco" %>
            <label class="btn btn-outline-primary" for="favor_tipo_ofrezco">Ofrezco</label>
          </div>

          <div class="mb-3">
            <%= f.label :titulo, "En una frase", class: "form-label" %>
            <%= f.text_field :titulo, class: "form-control", maxlength: 120, required: true,
                             placeholder: pido ? "¿Alguien me presta un taladro el sábado?" : "Llevo paquetes al centro los martes" %>
          </div>

          <div class="mb-3">
            <%= f.label :detalle, "Más detalle (opcional)", class: "form-label" %>
            <%= f.text_area :detalle, class: "form-control", rows: 3, maxlength: 1000 %>
          </div>

          <%= f.submit pido ? "Pedir" : "Ofrecer", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
