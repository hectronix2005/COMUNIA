<%# Un «pido» o un «ofrezco» en la lista: quién, qué y el botón para ayudar (o, si es tuyo, verlo). %>
<div class="card mb-2">
  <div class="card-body py-3">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div class="min-w-0">
        <span class="badge <%= favor.pido? ? 'chip-aviso' : 'chip-info' %> mb-1"><%= favor.pido? ? "Pide" : "Ofrece" %></span>
        <%= link_to favor.titulo, favor_path(favor), class: "fw-semibold text-decoration-none d-block" %>
        <% if favor.detalle.present? %>
          <div class="small text-muted text-truncate"><%= favor.detalle %></div>
        <% end %>
        <div class="text-muted texto-chico"><%= favor.user.nombre_corto %> · hace <%= time_ago_in_words(favor.created_at) %></div>
      </div>
      <div class="flex-shrink-0">
        <% if favor.user_id == current_user.id %>
          <%= link_to "Es tuyo", favor_path(favor), class: "btn btn-sm btn-outline-secondary" %>
        <% else %>
          <%= button_to (favor.pido? ? "Puedo ayudar" : "Me interesa"), ayudar_favor_path(favor), class: "btn btn-sm btn-success" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
