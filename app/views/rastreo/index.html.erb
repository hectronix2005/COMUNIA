<% content_for(:title, "Rastreo") %>

<div class="mb-4">
  <h1><i class="bi bi-activity"></i> Rastreo de pruebas</h1>
  <small class="text-muted">Qué hace cada persona: visitas, páginas, tiempo a la vista, clics y errores. No incluye Denuncias,
    la red ni lo escrito en los formularios. Se borra a mano cuando acaben las pruebas.</small>
</div>

<% if @actividad.any? %>
  <h2 class="h5">Activos por semana</h2>
  <p class="small text-muted">
    De lunes a domingo, sobre los miembros activos de hoy. <strong>Entraron</strong>: abrieron COMUNIA en esa comunidad.
    <strong>Participaron</strong>: publicaron, comentaron, dieron me gusta, escribieron en el chat, votaron, respondieron
    a un evento o usaron «Pido / ofrezco». Meta: que entre el <%= (ActividadSemanal::META * 100).round %> % cada semana.
    «—»: aún no había rastreo (empezó el 1-nov-2026).
  </p>
  <div class="table-responsive mb-4">
    <table class="table table-sm align-middle">
      <thead class="table-light">
        <tr>
          <th>Comunidad</th><th class="text-end">Miembros</th>
          <% @actividad.first.semanas.each do |semana| %>
            <th class="text-end"><%= semana.en_curso? ? "Esta semana" : "Semana del #{l(semana.inicio.to_date, format: '%-d %b')}" %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @actividad.each do |fila| %>
          <tr>
            <td>
              <%= fila.comunidad.nombre_display %>
              <% if fila.en_meta? %><span class="badge bg-success ms-1">en la meta</span><% end %>
            </td>
            <td class="text-end"><%= fila.miembros %></td>
            <% fila.semanas.each do |semana| %>
              <td class="text-end small">
                <% if semana.entraron.nil? %>
                  <span class="text-muted">—</span>
                <% else %>
                  <span class="fw-semibold"><%= semana.entraron %></span> entraron (<%= fila.porcentaje(semana.entraron) %> %)
                <% end %>
                <div class="text-muted"><%= semana.participaron %> participaron</div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @dias.any? %>
  <h2 class="h5">Por día</h2>
  <p class="small text-muted">El de hoy te llega como aviso a las 9 p. m. Sin contar a los superadmins ni a <%= ResumenRastreo.usernames_sin_contar.to_sentence(two_words_connector: " y ", last_word_connector: " y ") %>.</p>
  <div class="row g-3 mb-4">
    <% @dias.each do |dia| %>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-header fw-semibold"><%= dia.titulo %></div>
          <ul class="card-body small mb-0 ps-4">
            <% dia.lineas.each do |linea| %><li><%= linea %></li><% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="h5">Personas (<%= @orden.size %>)</h2>
<% if @orden.empty? %>
  <p class="text-muted">Nadie todavía.</p>
<% else %>
  <div class="table-responsive mb-4">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr><th>Persona</th><th class="text-end">Visitas</th><th class="text-end">Eventos</th><th class="text-end">Tiempo a la vista</th><th class="text-end">Errores</th><th>Última actividad</th></tr>
      </thead>
      <tbody>
        <% @orden.each do |id| %>
          <% persona = @personas[id] %>
          <tr>
            <td><%= link_to(persona ? persona.nombre_completo : "Usuario #{id}", rastreo_persona_path(id)) %>
              <div class="small text-muted"><%= persona&.username %></div></td>
            <td class="text-end"><%= @numero_visitas[id] %></td>
            <td class="text-end"><%= @eventos[id].to_i %></td>
            <td class="text-end text-nowrap"><%= duracion_rastreo(@segundos[id]) %></td>
            <td class="text-end"><% if (n = @errores[id].to_i).positive? %><span class="badge bg-danger"><%= n %></span><% else %>0<% end %></td>
            <td class="small text-nowrap"><%= l((@ultimo_evento[id] || @ultima[id]), format: :short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2 class="h5">Sin sesión (últimas <%= @anonimas.size %>)</h2>
<p class="small text-muted">Visitas de quien no ha entrado. Si luego entra en la misma visita, pasa a su nombre.</p>
<% if @anonimas.empty? %>
  <p class="text-muted">Ninguna.</p>
<% else %>
  <ul class="list-unstyled small">
    <% @anonimas.each do |visita| %>
      <li><%= link_to l(visita.started_at, format: :short), rastreo_visita_path(visita) %> — <%= visita.landing_page %>
        · <%= [visita.device_type, visita.browser, visita.os].compact.join(", ") %> · <%= @eventos_anonimas[visita.id].to_i %> eventos</li>
    <% end %>
  </ul>
<% end %>
