<turbo-frame id="notificaciones-lista">
  <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
    <div class="min-w-0">
      <strong class="small">Notificaciones</strong>
      <% unless platform_admin_context? || current_user.solo_red? %>
        <div class="texto-mini text-muted text-truncate">Solo de <%= current_logia.organizacion.nombre_display %></div>
      <% end %>
    </div>
    <% if @notificaciones.any? { |n| !n.leida } %>
      <%= button_to leer_todas_notificaciones_path, method: :post,
            class: "btn btn-link btn-sm p-0 text-decoration-none", style: "font-size:.72rem;" do %>
        Marcar todas leídas
      <% end %>
    <% end %>
  </div>

  <div class="list-group list-group-flush" style="max-height:340px;overflow-y:auto;">
    <% if @notificaciones.empty? %>
      <div class="text-center text-muted py-4">
        <i class="bi bi-bell-slash d-block mb-1" style="font-size:1.5rem;opacity:.4;"></i>
        <span class="texto-chico">Sin notificaciones</span>
      </div>
    <% else %>
      <% @notificaciones.each do |n| %>
        <% icon, color = case n.tipo
            when "chat_dm"    then ["bi-chat-dots-fill", "#6f42c1"]
            when "chat_canal" then ["bi-megaphone-fill", "var(--c-petroleo)"]
            when "cumpleanos" then ["bi-balloon-heart-fill", "#fd7e14"]
            else ["bi-bell-fill", "#6c757d"]
           end
        %>
        <a href="<%= n.enlace %>" data-turbo-frame="_top"
           class="list-group-item list-group-item-action d-flex gap-2 py-2 px-3 <%= n.leida ? '' : 'bg-light' %>"
           data-action="click->notifications#markRead"
           data-notification-id="<%= n.id %>"
           style="font-size:.83rem;border-left:3px solid <%= n.leida ? 'transparent' : color %>;">
          <i class="bi <%= icon %> flex-shrink-0 mt-1" style="color:<%= color %>;"></i>
          <div class="min-w-0 flex-grow-1">
            <div class="fw-semibold text-truncate"><%= n.titulo %></div>
            <% if n.cuerpo.present? %>
              <div class="text-muted text-truncate texto-chico"><%= n.cuerpo %></div>
            <% end %>
            <div class="text-muted texto-mini">
              <% if (rotulo = platform_admin_context? ? (n.organizacion&.nombre_display || n.origen) : n.origen) %>
                <span class="badge rounded-pill text-bg-light border me-1"><%= rotulo %></span>
              <% end %>
              <%= time_ago_in_words(n.created_at) %>
            </div>
          </div>
          <% unless n.leida %>
            <span class="align-self-center flex-shrink-0">
              <span class="rounded-circle d-inline-block bg-danger" style="width:8px;height:8px;"></span>
            </span>
          <% end %>
        </a>
      <% end %>
    <% end %>
  </div>

  <% if @otras_comunidades.any? %>
    <div class="border-top px-3 py-2 bg-light texto-chico">
      <div class="text-muted mb-1">En tus otras comunidades</div>
      <% @otras_comunidades.each do |comunidad, sin_leer| %>
        <a href="/t/<%= comunidad.slug %>/dashboard" data-turbo-frame="_top" class="d-flex justify-content-between text-decoration-none py-1">
          <span class="text-truncate"><%= comunidad.nombre_display %></span>
          <span class="badge rounded-pill bg-danger"><%= sin_leer > 99 ? "99+" : sin_leer %></span>
        </a>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
