<% content_for(:title, "Calendario en el teléfono") %>

<div class="container ancho-lectura">

  <div class="d-flex align-items-center justify-content-between mb-4 gap-2">
    <div>
      <h5 class="mb-0 fw-bold"><i class="bi bi-phone me-2" style="color:#1B2A4A;"></i>Calendario en el teléfono</h5>
      <div class="text-muted small mt-1">
        Tus <%= current_logia.t_reuniones.downcase %> y eventos aparecen solos en el calendario del teléfono, que es el
        que avisa. Si se cambia o se cancela algo, se actualiza en unas horas.
      </div>
    </div>
    <%= link_to calendario_index_path, class: "btn btn-sm btn-outline-secondary text-nowrap" do %>
      <i class="bi bi-calendar3 me-1"></i>Volver
    <% end %>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <% if @token %>
        <% feed = calendario_feed_url(token: @token, script_name: "") %>
        <% webcal = feed.sub(/\Ahttps?:/, "webcal:") %>

        <div class="d-flex flex-wrap gap-2 mb-4">
          <%= link_to "https://calendar.google.com/calendar/render?cid=#{CGI.escape(webcal)}",
                class: "btn btn-primary", target: "_blank", rel: "noopener noreferrer" do %>
            <i class="bi bi-google me-1"></i>Suscribirme en Google Calendar
          <% end %>
          <%= link_to webcal, class: "btn btn-outline-primary" do %>
            <i class="bi bi-apple me-1"></i>iPhone, Mac u Outlook
          <% end %>
        </div>

        <label class="form-label small text-muted" for="direccion-calendario">
          Para otra app de calendario, copia esta dirección y añádela como «calendario por URL» o «suscripción»:
        </label>
        <div class="input-group mb-2" data-controller="copiar">
          <input type="text" id="direccion-calendario" class="form-control form-control-sm font-monospace"
                 value="<%= feed %>" readonly data-copiar-target="texto">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-action="copiar#copiar" data-copiar-target="boton">
            <i class="bi bi-clipboard"></i> Copiar
          </button>
        </div>
        <div class="alert alert-warning small py-2 mb-4">
          <i class="bi bi-shield-lock me-1"></i>
          Esta dirección es solo tuya: quien la tenga ve tus próximos eventos. No la compartas. Si se te escapó,
          cámbiala y la anterior deja de funcionar.
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%= button_to calendario_suscripcion_path, method: :post, class: "btn btn-sm btn-outline-secondary",
                form: { data: { turbo_confirm: "La dirección actual dejará de funcionar y tendrás que suscribirte de nuevo. ¿Seguir?" } } do %>
            <i class="bi bi-arrow-clockwise me-1"></i>Cambiar la dirección
          <% end %>
          <%= button_to calendario_suscripcion_path, method: :delete, class: "btn btn-sm btn-outline-danger",
                form: { data: { turbo_confirm: "El calendario del teléfono dejará de actualizarse. ¿Seguir?" } } do %>
            <i class="bi bi-x-circle me-1"></i>Dejar de compartir
          <% end %>
        </div>
      <% else %>
        <p class="mb-3">
          Crea tu dirección personal y suscríbete una vez desde Google Calendar, el iPhone u Outlook. A partir de ahí
          verás las <%= current_logia.t_reuniones.downcase %> y eventos sin entrar a la app.
        </p>
        <%= button_to calendario_suscripcion_path, method: :post, class: "btn btn-primary" do %>
          <i class="bi bi-link-45deg me-1"></i>Crear mi dirección
        <% end %>
      <% end %>
    </div>
  </div>
</div>
