<% content_for :title, "Mis comunidades" %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <h1 class="h5 mb-0">Mis comunidades</h1>
  <%= link_to "Buscar comunidades", red_comunidades_path, class: "btn btn-outline-primary btn-sm" %>
</div>
<p class="small text-muted"><i class="bi bi-lock" aria-hidden="true"></i> Esta lista solo la ves tú. Las demás personas ven
  únicamente «certificado/a en N comunidades» y una banda del total de miembros.</p>
<% if @membresias.empty? %>
  <p>Aún no perteneces a ninguna. <%= link_to "Busca la tuya", red_comunidades_path %> o <%= link_to "propón una", new_red_comunidad_path %>.</p>
<% end %>
<ul class="list-group">
  <% @membresias.each do |m| %>
    <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
      <div>
        <%= link_to m.comunidad.nombre, red_comunidad_path(m.comunidad), class: "fw-semibold" %>
        <div class="small text-muted">
          <%= { "verificada" => (m.vencida? ? "Vencida" : "Verificada"), "solicitada" => "Pendiente de verificación",
                "rechazada" => "No aprobada", "revocada" => "Revocada", "retirada" => "Saliste" }.fetch(m.estado) %>
          <%= " · #{m.rol_texto}" if m.verificada? %>
          <%= " · vence el #{l(m.vence_el)}" if m.vence_el %>
          <%= " · comunidad #{m.comunidad.estado}" unless m.comunidad.certificada? %>
        </div>
        <% if m.motivo.present? && m.estado.in?(%w[rechazada revocada]) %><div class="small">Motivo: <%= m.motivo %></div><% end %>
      </div>
      <% if m.verificada? && m.rol != "miembro" && m.comunidad.certificada? %>
        <%= link_to "Gestionar", gestion_red_comunidad_path(m.comunidad), class: "btn btn-sm btn-primary" %>
      <% end %>
    </li>
  <% end %>
</ul>
