<%# Quién puede ver `objeto` (perfil o publicación). Las comunidades que se ofrecen son SOLO las de quien edita. %>
<fieldset class="mb-3">
  <legend class="form-label fs-6 fw-semibold mb-1">¿Quién puede verlo?</legend>
  <% Red::ConAlcance::ALCANCES.each do |valor, etiqueta| %>
    <div class="form-check">
      <input class="form-check-input" type="radio" name="alcance" id="alcance-<%= valor %>" value="<%= valor %>" <%= "checked" if objeto.alcance == valor %>>
      <label class="form-check-label" for="alcance-<%= valor %>"><%= etiqueta %></label>
    </div>
  <% end %>
  <% if alcance_opciones.any? %>
    <div class="ms-4 mt-1">
      <p class="small text-muted mb-1">Si eliges «Solo las comunidades que yo elija», marca cuáles:</p>
      <% elegidas = objeto.comunidad_ids_elegidas %>
      <% alcance_opciones.each do |nombre, id| %>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="comunidades[]" id="com-<%= id %>" value="<%= id %>" <%= "checked" if elegidas.include?(id) %>>
          <label class="form-check-label small" for="com-<%= id %>"><%= nombre %></label>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="small text-muted ms-4 mb-0">Aún no estás verificado en ninguna comunidad: con «Solo mis comunidades» nadie más lo verá hasta que entres en una.</p>
  <% end %>
  <p class="small text-muted mt-2 mb-0"><i class="bi bi-lock" aria-hidden="true"></i>
    Ninguna comunidad ve en qué otras estás: lo que muestran los demás es «certificado en N comunidades».</p>
</fieldset>
