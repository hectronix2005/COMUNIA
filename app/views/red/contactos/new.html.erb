<% content_for :title, "Contactar" %>
<p class="mb-2"><%= link_to red_publicacion_path(@publicacion) do %><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a la publicación<% end %></p>
<div class="card red-tarjeta"><div class="card-body">
  <h1 class="h5">Escribir sobre «<%= @publicacion.titulo %>»</h1>
  <p class="small text-muted">No necesitas cuenta. Quien publicó no te enseña su teléfono ni su correo: tú dejas un medio
    para que te responda. Lo guardamos cifrado y lo borramos a los 90 días.</p>
  <%= form_with url: contactar_red_publicacion_path(@publicacion), method: :post, data: { turbo: false } do %>
    <label class="form-label" for="nombre">Tu nombre</label>
    <input class="form-control mb-3" id="nombre" name="nombre" value="<%= @nombre %>" required minlength="2" maxlength="60" autocomplete="name">
    <label class="form-label" for="contacto">Tu correo o teléfono (para que te respondan)</label>
    <input class="form-control mb-3" id="contacto" name="contacto" value="<%= @contacto %>" required maxlength="120" autocomplete="email">
    <label class="form-label" for="cuerpo">Mensaje</label>
    <textarea class="form-control mb-3" id="cuerpo" name="cuerpo" rows="4" required minlength="5" maxlength="2000"><%= @cuerpo %></textarea>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" name="acepto" value="1" id="acepto" required>
      <label class="form-check-label small" for="acepto">Autorizo que mi nombre, mi medio de contacto y mi mensaje se entreguen
        a quien publicó, solo para responderme (Ley 1581 de 2012). <%= link_to "Política de datos", red_privacidad_path %>.</label>
    </div>
    <%= render "red/shared/captcha" %>
    <button class="btn btn-primary" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Enviar</button>
  <% end %>
</div></div>
