<% content_for :title, "Comunidades" %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <h1 class="h5 mb-0">Comunidades certificadas</h1>
  <% if user_signed_in? %><%= link_to "Proponer una", new_red_comunidad_path, class: "btn btn-outline-primary btn-sm" %><% end %>
</div>
<%= form_with url: red_comunidades_path, method: :get, class: "row g-2 mb-3", role: "search" do %>
  <div class="col-7 col-md-8">
    <label for="c-q" class="visually-hidden">Nombre</label>
    <input id="c-q" name="q" value="<%= @q %>" class="form-control" placeholder="Buscar por nombre" maxlength="80">
  </div>
  <div class="col-5 col-md-3">
    <label for="c-tipo" class="visually-hidden">Tipo</label>
    <select id="c-tipo" name="tipo" class="form-select">
      <option value="">Todos los tipos</option>
      <%= options_for_select(Red::Comunidad::TIPOS.invert, @tipo) %>
    </select>
  </div>
  <div class="col-md-1 d-grid"><button class="btn btn-secondary" type="submit">Filtrar</button></div>
<% end %>
<% if @comunidades.empty? %>
  <p class="text-muted">No hay comunidades con ese criterio.</p>
<% end %>
<div class="row g-2">
  <% @comunidades.each do |c| %>
    <div class="col-md-6">
      <a class="card red-tarjeta red-tarjeta-enlace h-100" href="<%= red_comunidad_path(c) %>">
        <div class="card-body">
          <div class="small text-muted"><%= c.tipo_texto %><%= " · #{c.ciudad}" if c.ciudad.present? %></div>
          <h2 class="h6 mb-1"><i class="bi bi-patch-check-fill text-success" aria-hidden="true"></i> <%= c.nombre %></h2>
          <div class="small text-muted"><%= Red::BANDAS.fetch(Red.banda(c.tamano_publico)).sub("ninguna comunidad", "recién certificada") %></div>
        </div>
      </a>
    </div>
  <% end %>
</div>
<div class="mt-3"><%= paginate @comunidades %></div>
