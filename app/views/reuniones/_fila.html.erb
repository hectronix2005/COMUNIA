<%= link_to reunion_path(reunion), class: "list-group-item list-group-item-action d-flex gap-3 align-items-center" do %>
  <div class="text-center flex-shrink-0" style="width:52px;">
    <div class="fw-bold fs-5 lh-1"><%= reunion.inicio.day %></div>
    <div class="text-muted text-uppercase" style="font-size:.7rem;"><%= I18n.l(reunion.inicio, format: "%b %Y") %></div>
  </div>
  <div class="flex-grow-1 min-w-0">
    <div class="fw-semibold text-truncate"><%= reunion.titulo %></div>
    <div class="text-muted small text-truncate">
      <%= reunion.inicio.strftime("%H:%M") %><%= " · #{reunion.lugar}" if reunion.lugar.present? %> · <%= reunion.logia.nombre_display %>
    </div>
  </div>
  <div class="flex-shrink-0"><%= render "reuniones/estado", reunion: reunion %></div>
<% end %>
