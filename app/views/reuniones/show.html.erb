<% content_for(:title, @reunion.titulo) %>

<div class="container" style="max-width:720px;">
  <div class="card border-0 shadow-sm overflow-hidden mb-3">
    <div style="background:<%= @reunion.logia.color_display %>;height:6px;"></div>
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
        <div>
          <div class="text-muted small"><%= @reunion.logia.t_reunion %> · <%= @reunion.logia.nombre_display %></div>
          <h4 class="fw-bold mb-1"><%= @reunion.titulo %></h4>
          <%= render "reuniones/estado", reunion: @reunion %>
          <% if @mi_ficha && @reunion.reunion_asistencias.exists?(miembro_id: @mi_ficha.id) %>
            <span class="badge bg-success-subtle text-success-emphasis ms-1"><i class="bi bi-person-check me-1"></i>Asististe</span>
          <% end %>
        </div>
        <% if gestiona_reunion?(@reunion) && !@reunion.cancelada? %>
          <%= link_to edit_reunion_path(@reunion), class: "btn btn-sm btn-outline-secondary", title: "Editar" do %><i class="bi bi-pencil"></i><% end %>
        <% end %>
      </div>

      <div class="d-flex gap-3 mt-3 mb-2">
        <i class="bi bi-clock text-muted mt-1"></i>
        <div>
          <div class="fw-semibold"><%= I18n.l(@reunion.inicio, format: "%A %-d de %B de %Y") %></div>
          <div class="text-muted small"><%= @reunion.inicio.strftime("%H:%M") %> – <%= @reunion.fin.strftime("%H:%M") %></div>
        </div>
      </div>
      <% if @reunion.lugar.present? %>
        <div class="d-flex gap-3 mb-2"><i class="bi bi-geo-alt text-muted"></i><span><%= @reunion.lugar %></span></div>
      <% end %>

      <% otras = @reunion.otras_de_la_serie.where(estado: :convocada).where(fin: Time.current..).limit(5) %>
      <% if otras.any? %>
        <div class="d-flex gap-3 mb-2">
          <i class="bi bi-arrow-repeat text-muted mt-1"></i>
          <div class="small">
            Se repite. Próximas fechas:
            <% otras.each_with_index do |r, i| %><%= ", " if i.positive? %><%= link_to I18n.l(r.inicio, format: "%-d %b"), reunion_path(r) %><% end %>
          </div>
        </div>
      <% end %>

      <% if @reunion.orden_del_dia.present? %>
        <h6 class="fw-bold small text-muted text-uppercase mt-4 mb-2">Orden del día</h6>
        <div style="white-space:pre-wrap;"><%= @reunion.orden_del_dia %></div>
      <% end %>

      <% if @reunion.convocada? %>
        <div class="border-top mt-4 pt-3">
          <h6 class="fw-bold small text-muted text-uppercase mb-2">¿Vas a ir?</h6>
          <div class="d-flex gap-2 mb-2">
            <%= button_to responder_reunion_path(@reunion, estado: "confirmado"), class: "btn btn-sm #{@mi_respuesta == 'confirmado' ? 'btn-success' : 'btn-outline-success'}" do %>
              <i class="bi bi-check-circle me-1"></i>Asistiré
            <% end %>
            <%= button_to responder_reunion_path(@reunion, estado: "rechazado"), class: "btn btn-sm #{@mi_respuesta == 'rechazado' ? 'btn-danger' : 'btn-outline-danger'}" do %>
              <i class="bi bi-x-circle me-1"></i>No puedo
            <% end %>
          </div>
          <% if @reunion.calendario_evento %>
            <div class="mb-2"><%= render "calendario/anadir", evento: @reunion.calendario_evento, url: reunion_url(@reunion) %></div>
          <% end %>
          <div class="text-muted small"><%= @confirmados %> confirman · <%= @rechazados %> no pueden · <%= @reunion.convocados.count %> convocados</div>
          <% if @quien_viene %>
            <details class="mt-2 small" id="quien-viene">
              <summary class="text-primary" style="cursor:pointer;">Ver quién (solo lo ves tú)</summary>
              <% { "confirmado" => "Confirman", "rechazado" => "No pueden", "sin_responder" => "Sin responder" }.each do |clave, rotulo| %>
                <% fichas = @quien_viene.fetch(clave, []) %>
                <div class="fw-semibold mt-2"><%= rotulo %> (<%= fichas.size %>)</div>
                <% if fichas.empty? %>
                  <div class="text-muted">Nadie</div>
                <% end %>
                <% fichas.each do |ficha| %>
                  <div class="d-flex align-items-center gap-2">
                    <span><%= ficha.user.nombre_corto %></span>
                    <% if ficha.user.acceso != :entro %>
                      <span class="text-muted">· aún no entra en la app</span>
                    <% elsif clave == "sin_responder" && ficha.telefono.present? %>
                      <%= link_to whatsapp_url(ficha.telefono, texto_whatsapp_pregunta(@reunion, ficha.user, reunion_url(@reunion))),
                                  class: "text-success", target: "_blank", rel: "noopener noreferrer", title: "Preguntarle por WhatsApp" do %>
                        <i class="bi bi-whatsapp"></i>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>

      <% if @reunion.celebrada? %>
        <div class="border-top mt-4 pt-3">
          <h6 class="fw-bold small text-muted text-uppercase mb-2">Asistencia</h6>
          <div class="mb-1"><span class="fs-4 fw-bold"><%= @reunion.quorum %> %</span>
            <span class="text-muted small">de quórum · <%= @reunion.reunion_asistencias.count %> de <%= @reunion.convocados.count %> convocados</span></div>
        </div>
      <% end %>

      <% if @reunion.acta_publicada? || (gestiona_reunion?(@reunion) && @reunion.acta.present?) %>
        <div class="border-top mt-4 pt-3" id="acta">
          <h6 class="fw-bold small text-muted text-uppercase mb-2">
            Acta <% unless @reunion.acta_publicada? %><span class="badge bg-warning text-dark ms-1">Borrador, solo la ves tú</span><% end %>
          </h6>
          <div style="white-space:pre-wrap;"><%= @reunion.acta %></div>
          <% if @reunion.acta_publicada? %>
            <div class="text-muted small mt-2">
              Publicada el <%= I18n.l(@reunion.acta_publicada_at, format: "%-d %b %Y") %><% if @reunion.acta_aprobada? %>
                · <span class="text-success"><i class="bi bi-check-circle-fill"></i> Aprobada</span><% if @reunion.acta_aprobada_en %>
                en <%= link_to @reunion.acta_aprobada_en.titulo, reunion_path(@reunion.acta_aprobada_en) %><% end %>
                el <%= I18n.l(@reunion.acta_aprobada_at, format: "%-d %b %Y") %><% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "reuniones/acta_anterior", reunion: @reunion %>
  <%= render "reuniones/acuerdos", reunion: @reunion %>
  <%= render "reuniones/propuestas", reunion: @reunion, mi_ficha: @mi_ficha %>
  <%= render "reuniones/votaciones", reunion: @reunion, mi_ficha: @mi_ficha %>

  <% if gestiona_reunion?(@reunion) && !@reunion.cancelada? %>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <% if @reunion.admite_propuestas? || @reunion.acta_publicada? %>
        <%= link_to whatsapp_url(nil, texto_whatsapp_reunion(@reunion, reunion_url(@reunion))), class: "btn btn-sm btn-success",
                    target: "_blank", rel: "noopener noreferrer",
                    title: "Abre WhatsApp con el mensaje escrito para que elijas el grupo. No lleva el orden del día ni el acta." do %>
          <i class="bi bi-whatsapp me-1"></i><%= @reunion.acta_publicada? ? "Avisar del acta por WhatsApp" : "Avisar por WhatsApp" %>
        <% end %>
      <% end %>
      <%= link_to qr_reunion_path(@reunion), class: "btn btn-sm btn-outline-primary" do %>
        <i class="bi bi-qr-code me-1"></i>QR de asistencia
      <% end %>
      <%= link_to asistencia_reunion_path(@reunion), class: "btn btn-sm btn-outline-primary" do %>
        <i class="bi bi-list-check me-1"></i>Registrar asistencia
      <% end %>
      <% if @reunion.celebrada? && !@reunion.acta_aprobada? %>
        <%= link_to edit_reunion_path(@reunion), class: "btn btn-sm btn-outline-primary" do %>
          <i class="bi bi-file-text me-1"></i><%= @reunion.acta.present? ? "Editar acta" : "Escribir acta" %>
        <% end %>
        <% if @reunion.acta.present? && !@reunion.acta_publicada? %>
          <%= button_to publicar_acta_reunion_path(@reunion), class: "btn btn-sm btn-primary",
                        form: { data: { turbo_confirm: "Se avisará a todos los convocados. ¿Publicar el acta?" } } do %>
            <i class="bi bi-send me-1"></i>Publicar acta
          <% end %>
        <% end %>
      <% end %>
      <% if @reunion.convocada? %>
        <% siguientes = @reunion.serie_desde_aqui.count %>
        <%= button_to cancelar_reunion_path(@reunion), class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Se avisará a todos los convocados. ¿Cancelar?" } } do %>
          <i class="bi bi-x-octagon me-1"></i><%= siguientes > 1 ? "Cancelar solo esta fecha" : "Cancelar" %>
        <% end %>
        <% if siguientes > 1 %>
          <%= button_to cancelar_reunion_path(@reunion, alcance: "siguientes"), class: "btn btn-sm btn-outline-danger",
                        form: { data: { turbo_confirm: "Se cancelarán #{siguientes} fechas y se avisará a los convocados. ¿Seguro?" } } do %>
            <i class="bi bi-x-octagon me-1"></i>Cancelar esta y las <%= siguientes - 1 %> siguientes
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "← #{current_logia.t_reuniones}", reuniones_path, class: "text-muted small text-decoration-none" %>
</div>
