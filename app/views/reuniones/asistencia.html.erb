<% content_for(:title, "Asistencia: #{@reunion.titulo}") %>

<div class="container" style="max-width:640px;">
  <h4 class="fw-bold mb-1">Asistencia</h4>
  <div class="text-muted small mb-3"><%= @reunion.titulo %> · <%= I18n.l(@reunion.inicio, format: "%-d %b %Y, %H:%M") %></div>

  <%= form_with url: registrar_asistencia_reunion_path(@reunion), method: :post do %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="list-group list-group-flush">
        <% @convocados.each do |m| %>
          <label class="list-group-item d-flex align-items-center gap-2">
            <%= check_box_tag "miembro_ids[]", m.id, @presentes.include?(m.id), class: "form-check-input m-0", id: "miembro_#{m.id}" %>
            <span class="flex-grow-1"><%= m.user.nombre_completo %></span>
            <% if @confirmaron.include?(m.user_id) %><span class="badge bg-light text-success">Confirmó</span><% end %>
          </label>
        <% end %>
        <% if @convocados.empty? %>
          <div class="list-group-item text-muted">No hay miembros activos convocados.</div>
        <% end %>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= submit_tag "Guardar asistencia", class: "btn btn-primary" %>
      <%= link_to "Volver", reunion_path(@reunion), class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
