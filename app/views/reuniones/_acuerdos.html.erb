<%# Acuerdos de la reunión y, en una convocatoria, los que quedaron sin cumplir en las anteriores del mismo grupo. %>
<% gestiona = gestiona_reunion?(reunion) %>
<% acuerdos = reunion.reunion_acuerdos.includes(responsable: :user).to_a %>
<% anteriores = reunion.convocada? ? reunion.acuerdos_anteriores_pendientes.to_a : [] %>
<% puede_apuntar = gestiona && reunion.admite_acuerdos? %>
<% if acuerdos.any? || anteriores.any? || puede_apuntar %>
  <div class="card border-0 shadow-sm mb-3" id="acuerdos">
    <div class="card-body p-4">
      <% if anteriores.any? %>
        <h6 class="fw-bold small text-muted text-uppercase mb-3"><i class="bi bi-arrow-return-right me-1"></i>Pendiente de antes</h6>
        <% anteriores.each do |a| %>
          <%= render "reuniones/acuerdo", reunion: reunion, acuerdo: a, gestiona: gestiona, de: a.reunion %>
        <% end %>
      <% end %>

      <% if acuerdos.any? || puede_apuntar %>
        <h6 class="fw-bold small text-muted text-uppercase mb-3 <%= 'mt-4' if anteriores.any? %>"><i class="bi bi-flag me-1"></i>Acuerdos</h6>
        <% acuerdos.each do |a| %>
          <%= render "reuniones/acuerdo", reunion: reunion, acuerdo: a, gestiona: gestiona, de: nil %>
        <% end %>
      <% end %>

      <% if puede_apuntar %>
        <%= form_with model: ReunionAcuerdo.new, url: reunion_acuerdos_path(reunion), class: "mt-3" do |f| %>
          <%= f.label :texto, "Apuntar un acuerdo", class: "form-label small" %>
          <%= f.text_field :texto, class: "form-control form-control-sm mb-2", required: true, maxlength: 500,
                           placeholder: "Reservar el salón para la cena de fin de año" %>
          <div class="d-flex flex-wrap gap-2">
            <%= f.collection_select :responsable_id, reunion.convocados.includes(:user).sort_by { _1.user.nombre_corto }, :id,
                                    ->(m) { m.user.nombre_corto }, { include_blank: "Sin responsable" },
                                    class: "form-select form-select-sm", style: "max-width:220px;", "aria-label": "Quién se encarga" %>
            <%= f.date_field :vence_el, class: "form-control form-control-sm", style: "max-width:170px;", "aria-label": "Para cuándo" %>
            <%= f.submit "Apuntar", class: "btn btn-sm btn-outline-primary" %>
          </div>
          <div class="form-text">Quien se encarga recibe un aviso y lo ve en su panel. Si no se cumple, sale en la siguiente convocatoria del grupo.</div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
