<% content_for(:title, current_logia.t_reuniones) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0 fw-bold"><i class="bi bi-people me-2" style="color:#c5a24d;"></i><%= current_logia.t_reuniones %></h4>
  <% if logias_convocables.any? %>
    <div class="d-flex gap-2">
      <%= link_to constancia_reuniones_path, class: "btn btn-sm btn-outline-secondary" do %>
        <i class="bi bi-graph-up me-1"></i>Constancia
      <% end %>
      <%= link_to new_reunion_path, class: "btn btn-sm btn-primary" do %>
        <i class="bi bi-plus-lg me-1"></i>Convocar
      <% end %>
    </div>
  <% end %>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <% if @mi_constancia&.convocadas&.positive? %>
      <div class="alert alert-light border small mb-3">
        <i class="bi bi-person-check me-1"></i>Tu asistencia en el último año: <strong><%= @mi_constancia.asistidas %> de <%= @mi_constancia.convocadas %></strong>
        (<%= @mi_constancia.porcentaje %> %)<% if @mi_constancia.ultima %> · la última, el <%= I18n.l(@mi_constancia.ultima, format: "%-d %b") %><% end %>
      </div>
    <% end %>
    <h6 class="text-muted text-uppercase small fw-bold mb-2">Próximas</h6>
    <% if @proximas.any? %>
      <div class="list-group mb-4"><%= render partial: "reuniones/fila", collection: @proximas, as: :reunion %></div>
    <% else %>
      <div class="text-center text-muted py-4 mb-4 border rounded">
        <i class="bi bi-calendar-event fs-2 d-block mb-1 opacity-25"></i>
        Nada convocado por ahora<%= " como #{current_logia.t_reunion.downcase}" if proximos_eventos.any? %>.
        <% if proximos_eventos.any? %>
          <div class="small mt-1">Los próximos eventos del calendario salen aquí debajo.</div>
        <% end %>
      </div>
      <%= render "calendario/proximos" %>
    <% end %>

    <% if @pasadas.any? %>
      <h6 class="text-muted text-uppercase small fw-bold mb-2">Anteriores</h6>
      <div class="list-group mb-3"><%= render partial: "reuniones/fila", collection: @pasadas, as: :reunion %></div>
      <%= paginate @pasadas %>
    <% end %>
  </div>
</div>
