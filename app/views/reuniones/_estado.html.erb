<% case reunion.estado %>
<% when "convocada" %><span class="badge bg-primary">Convocada</span>
<% when "celebrada" %><span class="badge bg-success">Celebrada</span>
<% when "cancelada" %><span class="badge bg-secondary">Cancelada</span>
<% end %>
<% if reunion.acta_publicada? %><span class="badge bg-light text-dark ms-1"><i class="bi bi-file-text me-1"></i>Acta</span><% end %>
