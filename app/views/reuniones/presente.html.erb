<% content_for(:title, "Asistencia: #{@reunion.titulo}") %>

<div class="container ancho-estrecho">
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4 text-center">
      <div class="text-muted small"><%= @reunion.logia.t_reunion %> · <%= I18n.l(@reunion.inicio, format: "%-d %b %Y, %H:%M") %></div>
      <h4 class="fw-bold mb-3"><%= @reunion.titulo %></h4>

      <% if @mi_ficha.nil? %>
        <p class="text-muted mb-0">No figuras entre quienes se convocan a «<%= @reunion.titulo %>».</p>
      <% elsif @ya_esta %>
        <p class="text-success fw-semibold mb-0"><i class="bi bi-check-circle-fill me-1"></i>Ya estás en la asistencia.</p>
      <% elsif !@codigo_valido %>
        <p class="text-muted mb-0">
          Este código no vale o la convocatoria no está en curso: funciona desde una hora antes
          hasta una hora después. Pide que te marquen en la lista.
        </p>
      <% else %>
        <%= button_to marcar_presente_reunion_path(@reunion, codigo: params[:codigo]), class: "btn btn-lg btn-success w-100" do %>
          <i class="bi bi-person-check me-1"></i>Estoy aquí
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="mt-3 text-center"><%= link_to "Ver la convocatoria", reunion_path(@reunion), class: "text-muted small" %></div>
</div>
