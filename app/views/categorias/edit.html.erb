<% content_for(:title, "Configurar categoría — COMUNIA") %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-tags me-2"></i>Configurar categoría</h1>
  <%= link_to categorias_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i>Volver
  <% end %>
</div>

<div class="card">
  <div class="card-body">
    <%= render "form", categoria: @categoria %>
  </div>
</div>
