<% content_for :title, "Mis denuncias" %>
<h1 class="h4 fw-bold">Mis denuncias</h1>
<p class="text-muted small">Solo las ves tú. Puedes retirar cualquiera: deja de salir en el muro y se borran sus fotos públicas.</p>

<% if @reportes.empty? %>
  <p class="text-muted">Aún no has publicado ninguna. <%= link_to "Denunciar", denuncias_nueva_path %></p>
<% end %>
<% estados = { "publicado" => ["Publicada", "bg-success"], "oculto" => ["Oculta mientras se revisa", "bg-warning text-dark"], "retirado" => ["Retirada", "bg-secondary"] } %>
<% @reportes.each do |r| %>
  <div class="card border-0 shadow-sm mb-2">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <div class="fw-semibold"><%= r.titulo %></div>
        <div class="small text-muted"><%= Denuncias::Catalogo::CATEGORIAS.fetch(r.categoria, r.categoria) %> · <%= r.localidad %> · <%= r.fecha.strftime("%d/%m/%Y") %></div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <% rotulo, clase = estados.fetch(r.estado, [r.estado, "bg-light text-dark"]) %>
        <span class="badge <%= clase %>"><%= rotulo %></span>
        <% unless r.estado == "retirado" %>
          <%= button_to "Retirar", denuncias_retirar_path(r.id), class: "btn btn-sm btn-outline-danger",
                        form: { data: { turbo_confirm: "¿Retirar esta denuncia del muro? No se puede deshacer." } } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
