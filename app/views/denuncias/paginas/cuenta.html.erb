<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>Mi cuenta · DENUNCIAPP</title>
  <%= csrf_meta_tags %>
  <link rel="stylesheet" href="/estaticos/estilo.css">
</head>
<body>
  <header class="barra">
    <a class="marca" href="/">DENUNCIAPP</a>
    <nav><a class="boton" href="/nuevo">Denunciar</a></nav>
  </header>
  <main>
    <h1>Mi cuenta</h1>
    <section id="elegir-alias" class="caja" hidden>
      <h2>Elige tu alias</h2>
      <p>Es lo único que se verá en el muro cuando publiques con tu cuenta. No se puede cambiar después.</p>
      <form id="form-alias">
        <label>Alias (3 a 20: minúsculas, números o _) <input name="alias" pattern="[a-z0-9_]{3,20}" required></label>
        <p class="error" role="alert"></p>
        <button>Guardar alias</button>
      </form>
    </section>
    <p id="saludo"></p>
    <section>
      <h2>Mis denuncias</h2>
      <div id="mias"></div>
    </section>
    <form method="post" action="/api/cuenta/salir" id="form-salir">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button class="secundario">Salir</button>
    </form>
  </main>
  <script type="module" src="/estaticos/cuenta.js"></script>
</body>
</html>
